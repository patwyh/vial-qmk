{
    "keyboard_name": "EKSS",
    "maintainer": "ergokeeb",
    "manufacturer": "ergokeeb",
    "url": "https://github.com/ergokeeb/ekss",
    "usb": {
        "vid": "0x4653",
        "pid": "0x0004",
        "device_version": "1.1.0",
        "suspend_wakeup_delay": 200
    },
    "processor": "RP2040",
    "bootloader": "rp2040",
    "features": {
        "backlight": true,
        "bootmagic": true,
        "extrakey": true,
        "nkro": true,
        "oled": true
        //"rgblight": false,
        //"rgb_matrix": true,
        //"mousekey": true
        //"encoder": true
    },
    "diode_direction": "COL2ROW",
    "dynamic_keymap": {
        "layer_count": 8
    },
    "matrix_pins": {
            "cols": ["GP29","GP28","GP27","GP26","GP22","GP20","GP23"],
            "rows": ["GP5" ,"GP4", "GP3", "GP2"]          
    },
    "bootmagic": {
        "enabled": true,
        "matrix": [ 0, 1 ]
    },
    "split": {
        "enabled": true,
        "bootmagic": {
            "matrix": [ 4, 1 ]
        },
        "matrix_pins": {
            "right": {
                "cols": ["GP29","GP28","GP27","GP26","GP22","GP20","GP23"],
                "rows": ["GP5" ,"GP4", "GP3", "GP2"]      
            }
        },
        "serial": {
            "driver": "vendor"
        },
        "transport": {
            "sync": {
                "matrix_state": true,
                "modifiers": true
            },
            "watchdog": true
        }
    },
 "layouts": {
